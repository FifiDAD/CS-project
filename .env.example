# ===================================================
# GLOBAL EVENTS DASHBOARD - API KEYS CONFIGURATION
# ===================================================
# Copy this file to .env and fill in your API keys
# ===================================================

# FREE API KEYS - Get them from these links:

# NewsAPI (500 requests/day free tier)
# https://newsapi.org/
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE

# FRED - Federal Reserve Economic Data (completely free)
# https://fred.stlouisfed.org/docs/api/fred-api.html
FRED_API_KEY=YOUR_FRED_API_KEY_HERE

# OpenWeather (free tier available)
# https://openweathermap.org/api
OPENWEATHER_KEY=YOUR_OPENWEATHER_KEY_HERE

# Guardian API (completely free)
# https://open-platform.theguardian.com/
GUARDIAN_API_KEY=YOUR_GUARDIAN_API_KEY_HERE

# ===================================================
# APIs THAT DON'T REQUIRE KEYS (Free):
# ===================================================

# ACLED - Armed Conflict Location & Event Data
# https://api.acleddata.com/
# No key needed - completely free

# GDELT - Global Database of Events, Language, Tone
# https://api.gdeltproject.org/
# No key needed - completely free

# World Bank Open Data
# https://api.worldbank.org/
# No key needed - completely free

# UN Comtrade - International Trade Statistics
# https://comtrade.un.org/
# Free but with rate limits

# NOAA Weather Alerts
# https://api.weather.gov/
# No key needed - completely free

# ===================================================
# HOW TO GET FREE API KEYS (5 minutes each):
# ===================================================

# 1. NewsAPI:
#    - Go to https://newsapi.org/
#    - Click "Get API Key"
#    - Sign up with email
#    - Copy your API key

# 2. FRED:
#    - Go to https://fred.stlouisfed.org/docs/api/fred-api.html
#    - Click "Request an API Key"
#    - Fill in the form
#    - Get instant API key

# 3. OpenWeather:
#    - Go to https://openweathermap.org/api
#    - Sign up for free account
#    - Click "API keys" section
#    - Use default "Current Weather Data"

# 4. Guardian:
#    - Go to https://open-platform.theguardian.com/
#    - Request API key (terms of service applies)
#    - Get instant key

# ===================================================
# INSTALLATION INSTRUCTIONS:
# ===================================================

# 1. Update api_config.py with your keys:
#    Replace "YOUR_NEWSAPI_KEY_HERE" with actual keys
#    
# OR
#
# 2. Load from environment variables:
#    - Create .env file in project root
#    - Add keys here
#    - Install: pip install python-dotenv
#    - In app.py add:
#      from dotenv import load_dotenv
#      import os
#      load_dotenv()
#      NEWSAPI_KEY = os.getenv('NEWSAPI_KEY', 'YOUR_KEY')

# ===================================================
# TESTING YOUR KEYS:
# ===================================================

# Run this in Python to test:
# python test_apis.py

