# ===================================================
# Logistics Dashboard — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ===================================================

# --- Keyed APIs ---
NEWSAPI_KEY=
FRED_API_KEY=
OPENWEATHER_KEY=
GUARDIAN_API_KEY=

# --- AISStream.io WebSocket ---
# Free key from https://aisstream.io/
AISSTREAM_KEY=

# --- Groq LLM (news dedup + threat classification) ---
# Free tier 14,400 req/day from https://console.groq.com
GROQ_API_KEY=
